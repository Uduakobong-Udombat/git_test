<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:10:15" />
  <Scene backgroundColor="#000000">
    <!-- Fully static, high-quality Guilloche dial; no baked-in hands, time or health values. -->
    <PartImage x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Image resource="dial" />
    </PartImage>
    <!-- Always-on: black base + soft blue indices, no textures or moving seconds. -->
    <PartImage x="0" y="0" width="450" height="450" alpha="0">
      <Variant mode="AMBIENT" target="alpha" value="255" />
      <Image resource="ambient" />
    </PartImage>

    <!-- These are WFF v1 platform data sources, not rendered/mockup values. -->
    <PartText x="183" y="118" width="84" height="34">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="27" color="#1C2737" weight="NORMAL">
          <Template><![CDATA[%d%%]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="100" y="183" width="58" height="39">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="24" color="#1C2737" weight="NORMAL">
          <Template><![CDATA[%d]]><Parameter expression="round([HEART_RATE])" /></Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="281" y="183" width="80" height="39">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="23" color="#1C2737" weight="NORMAL">
          <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]" /></Template>
        </Font>
      </Text>
    </PartText>
    <PartText x="316" y="265" width="28" height="29">
      <Variant mode="AMBIENT" target="alpha" value="0" />
      <Text align="CENTER">
        <Font family="SYNC_TO_DEVICE" size="20" color="#1C2737" weight="NORMAL">
          <Template><![CDATA[%d]]><Parameter expression="[DAY]" /></Template>
        </Font>
      </Text>
    </PartText>

    <AnalogClock x="0" y="0" width="450" height="450">
      <HourHand resource="hour" x="216" y="80" width="18" height="169" pivotX="0.5" pivotY="0.857988" />
      <MinuteHand resource="minute" x="218" y="48" width="14" height="202" pivotX="0.5" pivotY="0.876238" />
      <!-- The small seconds hand rotates about the inset register at 6 o'clock. -->
      <SecondHand resource="seconds" x="221" y="281" width="8" height="58" pivotX="0.5" pivotY="0.758621">
        <Variant mode="AMBIENT" target="alpha" value="0" />
        <Sweep frequency="15" />
      </SecondHand>
    </AnalogClock>
  </Scene>
</WatchFace>
